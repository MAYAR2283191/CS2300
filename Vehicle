
// This class represents one vehicle in the agency.
// It keeps the name, brand, year, insurance, daily rate and if the car is available. 
public class Vehicle {
    // Attributes
    private String name;
    private String brand;
    private boolean available;
    private int year;
    private boolean insuranceIncluded;
    private double dailyRate;

    //This creates a new vehicle, and it is available for rent by default.

    public Vehicle(String name, String brand, int year, boolean insuranceIncluded, double dailyRate) {
        setName(name);
        setBrand(brand);
        setYear(year);
        setInsuranceIncluded(insuranceIncluded);
        setDailyRate(dailyRate);
        this.available = true;
    }

    // Getters and Setters
    // Gets the name of the vehicle
    public String getName() {
        return name;
    }
    // changes the vehicle name and it can't be empty 
    public void setName(String name) {
        if (name == null || name.isBlank()) {
            throw new IllegalArgumentException("Vehicle name cannot be null or blank.");
        }
        this.name = name.trim();
    }
    // gets the brand of the vehicle
    public String getBrand() {
        return brand;
    }
    // changes the brand and it can't be empty
    public void setBrand(String brand) {
        if (brand == null || brand.isBlank()) {
            throw new IllegalArgumentException("Vehicle brand cannot be null or blank.");
        }
        this.brand = brand.trim();
    }
    // Checks if the vehicle is available to rent
    public boolean isAvailable() {
        return available;
    }
    // changes the availability of the vehicle
    public void setAvailable(boolean available) {
        this.available = available;
    }
    // gets the year the vehicle was made
    public int getYear() {
        return year;
    }
    // changes the year and it has to be a valid year
    public void setYear(int year) {
        if (year < 1886 || year > 2027) {
            throw new IllegalArgumentException("Invalid vehicle year: " + year);
        }
        this.year = year;
    }
    // checks if insurance is included
    public boolean isInsuranceIncluded() {
        return insuranceIncluded;
    }
    // changes if insurance is included or not
    public void setInsuranceIncluded(boolean insuranceIncluded) {
        this.insuranceIncluded = insuranceIncluded;
    }
    // gets the daily rate
    public double getDailyRate() {
        return dailyRate;
    }
    // changes the daily rate and it can't be negative
    public void setDailyRate(double dailyRate) {
        if (dailyRate < 0 || Double.isNaN(dailyRate) || Double.isInfinite(dailyRate)) {
            throw new IllegalArgumentException("Daily rate must be a valid non-negative number.");
        }
        this.dailyRate = dailyRate;
    }
    // Returns the vehicle information as text
    @Override
    public String toString() {
        return String.format(
            "Vehicle{year=%d, brand='%s', name='%s', dailyRate=%.2f, insuranceIncluded=%b, available=%b}",
            year, brand, name, dailyRate, insuranceIncluded, available
        );
    }
}
